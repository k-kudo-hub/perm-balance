{
	"name": "perm-balance",
	"version": "0.1.0",
	"description": "Check AI agent (Claude Code, Codex) permission settings by balancing risk and convenience",
	"type": "module",
	"bin": {
		"perm-balance": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",

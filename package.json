{
	"name": "perm-balance",
	"version": "0.1.0",
	"description": "AI エージェント（Claude Code・Codex）の権限設定を、リスクと利便性のバランスで点検する CLI",
	"type": "module",
	"bin": {
		"perm-balance": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"smol-toml": "^1.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}

		"prepare": "npm run build"
	},
	"dependencies": {
		"smol-toml": "^1.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k-kudo-hub/perm-balance.git"
	}
}
